{
  "name": "agency-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local --persist-to .wrangler/state",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply agency-desk --local",
    "db:migrate:remote": "wrangler d1 migrations apply agency-desk --remote"
  },
  "dependencies": {
    "@react-three/drei": "9.114",
    "@react-three/fiber": "8.17",
    "framer-motion": "^11.18.2",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wrangler": "^4.0.0"
  }
}
